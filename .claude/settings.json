{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-execution-log.sh\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Syncing docs/execution-log.md"
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/sync-execution-log.sh\"",
            "shell": "bash",
            "timeout": 15,
            "statusMessage": "Syncing docs/execution-log.md"
          }
        ]
      }
    ]
  }
}
