# Wyrhta Labs household stack — environment template.
# Copy to deploy/.env and fill in. deploy/.env is git-ignored; NEVER commit it.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Variables marked REQUIRED are `${VAR:?}`-guarded in the compose files.
# Compose validates the WHOLE model before starting anything, so every one of
# them must be set even for a partial first bring-up where the feature it
# belongs to is deliberately off — one blank value fails `docker compose up`
# with no container started at all. Everything else may stay blank.
#
# Never put a trailing `# comment` on a value line: deploy/dev-up.mjs reads
# this file with a plain `KEY=rest-of-line` parser and would take the comment
# for the value.
#
# scripts/check-env-template.mjs asserts that this file and the compose files
# agree on which variables exist. Run it after editing either.

# --- Postgres: one cluster, three databases --------------------------------
# REQUIRED
POSTGRES_SUPERUSER_PASSWORD=
# REQUIRED
HEORTH_DB_PASSWORD=
# REQUIRED
KITH_DB_PASSWORD=
# Firefly III's own role and database (ADR 0016). Blank makes initdb skip the
# role entirely — but compose.prod.yml guards it with `:?` on the firefly
# service, so a PROD stack needs a value here even if you never connect a bank.
# To run without ingestion, leave `firefly`/`firefly-importer` stopped.
# REQUIRED
FIREFLY_DB_PASSWORD=

# --- Per-service auth. Both JWT secrets MUST differ (32+ chars each).
# A shared secret would make a token minted by one service valid at another.
# HEORTH_JWT_SECRET also keys Heorth's encryption of stored M365 refresh
# tokens — rotating it invalidates them and forces re-consent. It is ALSO the
# fallback key for stored library credentials unless LIBRARY_ENCRYPTION_KEY is
# set below; read that block before planning a rotation.
# REQUIRED
HEORTH_JWT_SECRET=
# REQUIRED
KITH_JWT_SECRET=
# REQUIRED
HEORTH_ADMIN_PASSWORD=
# REQUIRED
KITH_ADMIN_PASSWORD=

# --- Heorth household identity --------------------------------------------
# REQUIRED
HOUSEHOLD_NAME=
# REQUIRED
HEORTH_ADMIN_EMAIL=

# --- Library credential encryption (Heorth only) ---------------------------
# The AES-256-GCM key for credentials the library module stores (Trakt & co).
# Leave BLANK and Heorth derives one by HKDF over HEORTH_JWT_SECRET, warning at
# every boot. That silently PINS HEORTH_JWT_SECRET for the life of those
# credentials: rotating it afterwards makes every stored library credential
# undecryptable, and there is no recovery path. Set a dedicated key and the two
# secrets rotate independently.
#
# base64 decoding to EXACTLY 32 bytes — NOT hex like the other secrets:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
LIBRARY_ENCRYPTION_KEY=

# --- Satellite identity: Heorth signs, satellites verify (ADR 0009) ----------
# Heorth mints short-lived member tokens for satellites and publishes the public
# half at /.well-known/jwks.json. This key is SEPARATE from HEORTH_JWT_SECRET on
# purpose: that secret also derives the M365 refresh-token encryption key and
# must never leave Heorth.
# Generate (Ed25519, single-line JWK - no newline escaping to get wrong):
#   node -e 'const{generateKeyPairSync}=require("crypto");const{privateKey}=generateKeyPairSync("ed25519");const j=privateKey.export({format:"jwk"});j.alg="EdDSA";j.kid="heorth-YYYY-MM";j.use="sig";console.log(JSON.stringify(j))'
SATELLITE_SIGNING_KEY=
SATELLITE_SIGNING_KID=
SATELLITE_SIGNING_ALG=EdDSA
# The rotation overlap slot: a SECOND key published in the JWKS but NEVER used
# for signing. It holds either the outgoing key (still verifying tokens in
# flight) or the incoming one (pre-published before it goes active). Being
# publish-only it accepts PUBLIC material too, so retired private material can
# be deleted from the host while its public half stays published.
# KEY and KID together or both blank, and only alongside an active key above.
SATELLITE_SIGNING_KEY_SECONDARY=
SATELLITE_SIGNING_KID_SECONDARY=
# Blank means EdDSA. Set it only when the secondary key is RS256.
SATELLITE_SIGNING_ALG_SECONDARY=
# Comma-separated lowercase slugs. Only satellites named here can be minted for.
SATELLITE_AUDIENCES=kithledger
# KithLedger's side: where to fetch Heorth's public keys, and its own audience.
HEORTH_JWKS_URL=http://heorth:3000/.well-known/jwks.json
SATELLITE_AUDIENCE=kithledger

# --- heorth-mcp: the household's MCP server (ADR 0008) ---------------------
# Its own container, a pure REST client of the services. Prod pins an image
# tag; dev builds from ../heorth-mcp. Upstream call timeout in ms.
# REQUIRED
HEORTH_MCP_IMAGE_TAG=
UPSTREAM_TIMEOUT_MS=10000

# --- Microsoft 365 (Heorth only): ALL FIVE, or ALL BLANK ------------------
# Partial presence is a startup error. All blank = module registers as a no-op.
# Real tenant/client/mailbox values belong in deploy/.env only, never here.
# The redirect URI is <base>/api/v1/integrations/m365/callback. The household
# task list is designated in the UI (PUT /api/v1/tasks/household-list), not by
# env — there is no M365_SHARED_TODO_LIST.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=
M365_FAMILY_MAILBOX=

# --- Google Calendar + Tasks (Heorth only): ALL THREE, or ALL BLANK --------
# Same contract as M365. Redirect URI: <base>/api/v1/integrations/google/callback.
# Enable BOTH the Calendar API and the Tasks API on the Google Cloud project.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Mirror poll interval for every provider (seconds, floored at 60). Optional.
INTEGRATIONS_SYNC_INTERVAL_SECONDS=300

# --- KithLedger reminders feed (Heorth only): ALL FOUR, or ALL BLANK -------
# Partial presence is a startup error. All blank = module registers as a no-op.
# THE WHOLE BLOCK STAYS BLANK UNTIL THE KEY EXISTS. The kl_ key is minted from
# a RUNNING KithLedger, so a first bring-up necessarily has all four blank —
# fill them in afterwards and recreate `heorth`.
#
# Inside the stack the base URL is the service name: http://kithledger:3000
# KITH_PUBLIC_URL is the browser-facing URL for opening KithLedger's web UI
# from Heorth (compose.prod.yml publishes it on 4002). Blank falls back to
# KITH_BASE_URL, which a browser outside the compose network cannot resolve.
#
# Mint the key in KithLedger as the local admin: POST /api/v1/auth/token
# (admin password) -> POST /api/v1/auth/keys
# {"name":"heorth-dashboard","kind":"household"} -> "kl_..." (shown once).
# The "kind" is the part that matters: the always-on reminders feed has no
# logged-in member, so only a household-kinded key is accepted (ADR 0004 §2).
# A member- or ops-kinded key is refused at boot.
KITH_BASE_URL=
KITH_PUBLIC_URL=
KITH_API_KEY=
# Your DECLARATION of which kind you pasted above — Heorth cannot introspect a
# key. Optional within the group (blank defaults to `household`, the only legal
# value); setting it while the rest of the block is blank is a startup error,
# which is why it ships commented out.
# KITH_API_KEY_KIND=household

# --- Bank ingestion: Firefly III sidecar (ADR 0016) ------------------------
# Firefly talks to banks and NOTHING else. It is not the ledger — Feoh remains
# the system of record — and its web UI is an operator tool for connecting
# banks, never a household surface. Dev and prod only; the demo stack runs no
# Firefly and seeds its import inbox instead.
#
# APP_KEY must be EXACTLY 32 characters or Firefly refuses to boot:
#   node -e "console.log(require('crypto').randomBytes(16).toString('hex'))"
# REQUIRED
FIREFLY_APP_KEY=
# Must match the URL your browser uses, or Firefly answers "invalid host".
# 14001 is the DEV host port. compose.prod.yml publishes Firefly on 4001, so a
# prod .env needs the URL the operator's browser actually uses there.
# REQUIRED
FIREFLY_APP_URL=http://localhost:14001
# Where HEORTH reaches Firefly — the compose service name, not the host port.
FIREFLY_BASE_URL=http://firefly:8080
#
# Firefly's operator account. deploy/dev-up.sh creates it on first run and uses
# it to mint the token below. Firefly enforces a 16-character minimum password.
# This account exists to connect banks; it is NOT a household member, and its
# password living in a local dev env file is why none of this is done in prod.
# Read by deploy/dev-up.mjs only — no compose file passes these to a container.
FIREFLY_OPERATOR_EMAIL=operator@dev.invalid
FIREFLY_OPERATOR_PASSWORD=
#
# The API token Heorth and the Data Importer present to Firefly. Firefly mints
# these through its web UI only, so deploy/dev-up.sh drives that UI for you:
# it registers the operator above, asks Passport for a token, verifies the
# token against /api/v1/about, writes it here, and flips FEOH_IMPORT_ENABLED
# to true. If it ever fails, the bring-up still succeeds and you can do it by
# hand: FIREFLY_APP_URL -> Profile -> OAuth -> Personal Access Tokens.
#
# IN PRODUCTION THIS IS A MANUAL STEP. Nothing generates an operator account on
# the household server.
FIREFLY_PAT=
# Turned on by dev-up.sh once a PAT exists. Off means Heorth's import scheduler
# does not start; the inbox, the rules UI and confirming pending rows keep
# working, because those are pure Feoh writes.
FEOH_IMPORT_ENABLED=false
# The household's one currency (ISO 4217). Default EUR.
FEOH_CURRENCY=EUR

# --- Shared tuning knobs ---------------------------------------------------
JWT_TTL_SECONDS=604800
DB_POOL_MAX=10

# --- CORS (compose.prod.yml only; compose.dev.yml hardcodes "*") -----------
# Defaults below are WIDE OPEN ("*") if left blank — prod Heorth (household +
# finance data) and KithLedger (relationship data) would accept cross-origin
# requests from any site. Set these to the real household origin(s) before
# going live.
# HEORTH_CORS_ORIGIN=*
# KITH_CORS_ORIGIN=*

# --- Backups ---------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Set to true to run db-backup once and exit, instead of looping forever.
# BACKUP_ONCE=false

# --- Prod only: pinned image tags (compose.prod.yml) ----------------------
# REQUIRED
HEORTH_IMAGE_TAG=
# REQUIRED
KITH_IMAGE_TAG=

# --- Timezone (both Firefly containers; blank means Europe/Berlin) ---------
# TZ=Europe/Berlin
