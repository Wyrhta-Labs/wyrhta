# Wyrhta Labs household stack — environment template.
# Copy to deploy/.env and fill in. deploy/.env is git-ignored; NEVER commit it.
# Generate a secret: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Postgres: one cluster, two databases ----------------------------------
POSTGRES_SUPERUSER_PASSWORD=
HEORTH_DB_PASSWORD=
KITH_DB_PASSWORD=

# --- Per-service auth. Both JWT secrets MUST differ (32+ chars each).
# A shared secret would make a token minted by one service valid at another.
# HEORTH_JWT_SECRET also keys Heorth's encryption of stored M365 refresh
# tokens — rotating it invalidates them and forces re-consent.
HEORTH_JWT_SECRET=
KITH_JWT_SECRET=
HEORTH_ADMIN_PASSWORD=
KITH_ADMIN_PASSWORD=

# --- Heorth household identity --------------------------------------------
HOUSEHOLD_NAME=
HEORTH_ADMIN_EMAIL=

# --- Heorth finance module (merged from Feoh, ADR 0007) --------------------
# Off by default. Set to true to enable the built-in finance module.
FEOH_ENABLED=false

# --- Microsoft 365 (Heorth only): ALL SIX, or ALL BLANK -------------------
# Partial presence is a startup error. All blank = module registers as a no-op.
# Real tenant/client/mailbox values belong in deploy/.env only, never here.
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_REDIRECT_URI=
M365_FAMILY_MAILBOX=
M365_SHARED_TODO_LIST=

# --- Shared tuning knobs ---------------------------------------------------
JWT_TTL_SECONDS=604800
DB_POOL_MAX=10

# --- CORS (compose.prod.yml only; compose.dev.yml hardcodes "*") -----------
# Defaults below are WIDE OPEN ("*") if left blank — prod Heorth (household +
# finance data) and KithLedger (relationship data) would accept cross-origin
# requests from any site. Set these to the real household origin(s) before
# going live.
# HEORTH_CORS_ORIGIN=*
# KITH_CORS_ORIGIN=*

# --- Backups ---------------------------------------------------------------
BACKUP_INTERVAL_SECONDS=86400
BACKUP_RETENTION_DAYS=14
# Set to true to run db-backup once and exit, instead of looping forever.
# BACKUP_ONCE=false

# --- Prod only: pinned image tags (compose.prod.yml) ----------------------
HEORTH_IMAGE_TAG=
KITH_IMAGE_TAG=
